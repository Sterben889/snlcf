// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  EDITOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Email/password administration
  passwordHash String?
  role         UserRole @default(EDITOR)
  active       Boolean  @default(true)

  accounts Account[]
  sessions Session[]
  posts    Post[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SiteContent {
  id           Int      @id
  heroTitle    String   @default("To Glorify God")
  heroSubtitle String   @default("by fulfilling the Great Commission")
  heroImageUrl String   @default("/filter.png")
  updatedAt    DateTime @updatedAt

  descTitle      String @default("Sunday Service")
  descBody       String @default("Join us every Sunday as we worship God, learn from His Word, and grow together as a church family.")
  descImageUrl   String @default("")
  descTime       String @default("10:00 am")
  descLocation   String @default("3532 Fairlight Dr. Saskatoon, SK")
  descButtonText String @default("Learn more")
  descButtonUrl  String @default("#")

  missionTitle             String @default("O GOD, WITH ALL OUR HEARTS WE LONG FOR YOU.")
  missionTransformation    String @default("Come TRANSFORM US to be Christ-centered, Spirit-empowered, Mission-focused People")
  missionDisciplesTitle    String @default("MULTIPLYING DISCIPLES")
  missionDisciplesSubtitle String @default("EVERYWHERE")
  missionStatement         String @default("To glorify God by fulfilling the Great Commission through building Christ-committed followers in Saskatoon and beyond.")

  aboutHeroTitle    String @default("About Us")
  aboutHeroSubtitle String @default("Learn more about our heart, mission, and the people who make up our church family")

  aboutWhoTitle String @default("Who We Are")

  aboutWhoParagraph1 String @default("Saskatoon New Life Community Fellowship is a vibrant, Christ-centered church family located in the heart of Saskatoon, Saskatchewan. We are a community of believers who have been transformed by the love of Jesus Christ and are passionate about sharing that love with others.")

  aboutWhoParagraph2 String @default("Our church family comes from diverse backgrounds, ages, and walks of life, but we are united by our common faith in Jesus Christ. We believe that every person has value and worth in God's eyes, and we strive to create an environment where everyone feels welcomed, loved, and accepted.")

  aboutWhoParagraph3 String @default("Whether you're taking your first steps in faith, have been walking with Jesus for years, or are simply curious about Christianity, we invite you to join us as we grow together in our relationship with God and with one another.")

  aboutMissionTitle String @default("Purpose and Mission Statement")

  aboutVisionTitle String @default("Vision Prayer")

  aboutCtaTitle      String @default("Ready to Join Our Family?")
  aboutCtaBody       String @default("We'd love to meet you and help you take your next steps in faith. Come as you are — you belong here.")
  aboutCtaVisitText  String @default("Visit Us This Sunday")
  aboutCtaVisitUrl   String @default("https://www.google.com/maps/dir/?api=1&destination=3532+Fairlight+Dr,+Saskatoon,+SK+S7M+4T3")
  aboutCtaEventsText String @default("See Our Events")
  aboutCtaEventsUrl  String @default("/events")

  eventsHeroTitle    String @default("Upcoming Events")
  eventsHeroSubtitle String @default("See what's coming up and find a place to connect with our community.")
}

enum EventRecurrence {
  NONE
  WEEKLY
}

model ChurchEvent {
  id               String          @id @default(cuid())
  title            String
  description      String
  location         String?
  startsAt         DateTime
  recurrence       EventRecurrence @default(NONE)
  recurrenceEndsAt DateTime?
  published        Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([startsAt])
}

model StatementOfFaithItem {
  id          String   @id @default(cuid())
  title       String
  description String
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model LeadershipMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String
  email     String?
  phone     String?
  imageUrl  String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}
