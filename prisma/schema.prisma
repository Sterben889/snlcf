enum EventRecurrence {
  NONE
  WEEKLY
}

model ChurchEvent {
  id               String          @id @default(cuid())
  title            String
  description      String
  location         String?
  startsAt         DateTime
  recurrence       EventRecurrence @default(NONE)
  recurrenceEndsAt DateTime?
  published        Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([startsAt])
}

model StatementOfFaithItem {
  id          String   @id @default(cuid())
  title       String
  description String
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model LeadershipMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String
  email     String?
  phone     String?
  imageUrl  String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

enum GivingMethodIcon {
  EMAIL
  MAIL
  CHURCH
}

model GivingMethod {
  id          String           @id @default(cuid())
  title       String
  description String
  detail      String
  href        String?
  icon        GivingMethodIcon @default(EMAIL)
  sortOrder   Int              @default(0)
  published   Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([sortOrder])
}

model GatherGroup {
  id          String             @id @default(cuid())
  title       String
  schedule    String
  location    String
  description String
  sortOrder   Int                @default(0)
  published   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  images      GatherGroupImage[]

  @@index([sortOrder])
}

model GatherGroupImage {
  id        String   @id @default(cuid())
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  groupId String
  group   GatherGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

model ServeMinistry {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model Testimony {
  id   String @id @default(cuid())
  slug String @unique

  kicker      String
  title       String
  summary     String
  authorLine  String
  body        String
  closingText String?

  imageUrl String?

  sortOrder Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([published])
}
